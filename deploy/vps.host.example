# Referência da VM Skadi (sem senha).
# Copie os dados reais para `.env.vps` na sua máquina — esse arquivo é gitignored.

Nome=vm-squad-xp-01
VMID=9000001
Template=Skadi (1 vCPU / 4GB / 50GB)
IP=192.168.25.108

# SSH
# ssh root@192.168.25.108
# ssh root@sshSquadXp-01.hostsoftcom.cloud

Traefik=http://traefik-squad-xp-01.hostsoftcom.cloud
Portainer=http://portainer-squad-xp-01.hostsoftcom.cloud

# Overlay do Traefik nesta VM (docker network ls)
TRAEFIK_NETWORK=network_public
TRAEFIK_ENTRYPOINT=web
TRAEFIK_HOST=softlflow.hostsoftcom.cloud
