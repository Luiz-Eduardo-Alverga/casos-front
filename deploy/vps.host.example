# Referência da VM Skadi (sem senha).
# Copie os dados reais para `.env.vps` na sua máquina — esse arquivo é gitignored.

Nome=vm-squad-xp-01
VMID=9000001
Template=Skadi (1 vCPU / 4GB / 50GB)
IP=192.168.25.108

# SSH público (GitHub Actions). Não use o IP 192.168.25.108 no CI.
# ssh root@ssh-squad-xp-01.hostsoftcom.cloud

Traefik=https://traefik-squad-xp-01.hostsoftcom.cloud
Portainer=https://portainer-squad-xp-01.hostsoftcom.cloud
App=https://softflow.hostsoftcom.cloud
Assistant=https://assistant.hostsoftcom.cloud

# Overlay do Traefik nesta VM (docker network ls)
TRAEFIK_NETWORK=network_public
TRAEFIK_ENTRYPOINT=web
TRAEFIK_HOST=softflow.hostsoftcom.cloud
